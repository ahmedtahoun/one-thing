# The admin panel's configuration. Never commit real values.
#
# Live: all of these. The database URL is Supabase's connection string; it
# bypasses row-level security, so it only ever lives on the panel's server.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Pseudonymises the analytics export: the same person, the same ID, and no
# way back without this key. Keep it secret and keep it stable.
DATASET_KEY=
# Optional: the app version the Troubleshoot check calls "latest", and where
# "Open in App Store Connect" / "Open in Play Console" go.
LATEST_APP_VERSION=
APP_STORE_CONNECT_URL=
PLAY_CONSOLE_URL=
# Opens the one-time /setup page that makes the first Owner, while the team
# is empty. Any word you choose; delete it once the Owner exists. DEPLOY.md § 4.
ADMIN_SETUP_SECRET=
# Every date in the panel is written in this zone (default Asia/Riyadh).
NEXT_PUBLIC_ADMIN_TIME_ZONE=

# Demo: the handoff's seed data and the prototype's sign-in rules, with no
# database. Never set together with DATABASE_URL.
# ADMIN_DEMO=1
