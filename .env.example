# Supabase project the app talks to. Both values are publishable: every table
# is behind row-level security, so the anon key grants nothing on its own.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in. Both are OAuth 2.0 client IDs from the Google Cloud console
# (not Play Console) and both are publishable — a client ID identifies the app,
# it does not authorise anything. The WEB one is what the ID token is issued
# for and what Supabase verifies against, so it is needed on iOS and Android
# alike; the IOS one is what the iOS app identifies itself as, and app.config.js
# builds the required URL scheme from it. Android needs no client ID here: it
# is matched by package name and signing certificate SHA-1 in the console.
#
# Sign in with Apple needs nothing in this file. Its Services ID, key, Team ID
# and Key ID go into the Supabase dashboard; the app's side is the entitlement
# app.config.js turns on.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Server-side only — never prefix these with EXPO_PUBLIC_, which would bundle
# them into the app. They belong to the backend that fronts the assistant and
# receives store webhooks.
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
