{
  "name": "the-one-thing",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"supabase/functions/**/*.test.ts\"",
    "test:db": "tsx --test scripts/test-sync-db.ts scripts/test-assist-db.ts scripts/test-store-db.ts scripts/test-export-db.ts scripts/test-schedules-db.ts",
    "verify:colours": "node scripts/verify-oklch.js scripts/oklch-colours.txt",
    "capture:app": "expo export --platform web && node scripts/capture-screens.js",
    "capture:prototype": "node scripts/capture-prototype.js",
    "capture:store": "expo export --platform web && node scripts/capture-store.js",
    "icons": "node scripts/make-icons.js",
    "compare": "node scripts/compare-to-prototype.js .screens .screens-prototype scripts/screen-pairs.json",
    "schema:check": "bash scripts/check-schema.sh",
    "db:bundle": "node scripts/bundle-migrations.js",
    "check:project": "node scripts/check-project.js",
    "content:port": "node scripts/port-content.js",
    "content:inline": "node scripts/extract-inline-copy.js",
    "measure": "node scripts/measure-prototype-type.js",
    "drift": "node scripts/measure-drift.js",
    "smoke": "node scripts/smoke-tasks.js && node scripts/smoke-people.js && node scripts/smoke-compose.js && node scripts/smoke-day.js && node scripts/smoke-capture.js && node scripts/smoke-analytics.js",
    "typecheck:functions": "tsc -p supabase/functions",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "^8.31.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-contacts": "~57.0.6",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "~5.8.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-mail-composer": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.0",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-text-extractor": "^2.0.0",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "google-auth-library": "11.2.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@babel/standalone": "^7.29.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "pixelmatch": "^5.3.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "prototype-react": "npm:react@^18.3.1",
    "prototype-react-dom": "npm:react-dom@^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
